# Prod: set to "production". DATABASE_URL/REDIS_URL below are overridden by docker-compose.prod.yml's
# `environment:` block (which derives DATABASE_URL from the root .env's POSTGRES_PASSWORD) — the
# values here only matter for the dev docker-compose.yml.
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg2://axion:axion@postgres:5432/axion_invoice
REDIS_URL=redis://redis:6379/0

# Prod: generate a real random secret, e.g. `openssl rand -hex 32` — never reuse the dev default.
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Prod: set to true (refresh cookie requires HTTPS) once served behind TLS.
COOKIE_SECURE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Prod: use live-mode keys from your Stripe dashboard, not test-mode ones.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

PDF_STORAGE_DIR=/app/generated_pdfs
LOGO_STORAGE_DIR=/app/generated_logos

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@axioninvoice.local

# Vite dev server picks the next free port if 5173 is taken (5174, 5175, ...) — list every port
# you actually use, comma-separated.
# Prod: set to the real frontend origin(s), e.g. https://app.yourdomain.com.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Prod: set to the real frontend origin — used for Stripe checkout success/cancel and portal
# return URLs, so a stale localhost value here silently breaks those redirects in prod.
FRONTEND_URL=http://localhost:5173
