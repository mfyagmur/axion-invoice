# Used by docker-compose.prod.yml (docker compose reads .env from the compose file's directory).
# Copy to .env and fill in before running:
#   docker compose -f docker-compose.prod.yml up -d --build

# Postgres superuser password for the axion role (also injected into backend/celery-worker's
# DATABASE_URL — must match whatever's actually used, this is the single source of truth for it).
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Baked into the frontend bundle at build time (Vite inlines VITE_* vars) — point this at the
# backend's public URL, e.g. https://api.yourdomain.com/api/v1.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_GOOGLE_CLIENT_ID=
